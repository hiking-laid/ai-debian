# Secrets & ops (copy to .env). Never commit real values.
TDP_POSTGRES_DSN=postgresql+psycopg://user:pass@host:5432/toddler_dinner

# --- LLM provider -----------------------------------------------------------
# Choose one: copilot | openai | azure | anthropic | gemini
TDP_LLM_PROVIDER=copilot
TDP_LLM_MODEL=gpt-4o

# OpenAI / Azure / Anthropic / Gemini: set the API key
TDP_LLM_API_KEY=

# GitHub Copilot: run `toddler-dinner login-copilot` once (device flow). No token needed here.

# Gemini (when TDP_LLM_PROVIDER=gemini): set TDP_LLM_API_KEY and e.g. TDP_LLM_MODEL=gemini-1.5-flash

# Azure OpenAI (when TDP_LLM_PROVIDER=azure): resource endpoint + deployment name.
# TDP_AZURE_ENDPOINT=https://my-resource.openai.azure.com
# TDP_AZURE_DEPLOYMENT=my-gpt4o-deployment
# TDP_AZURE_API_VERSION=2024-02-15-preview
# API shape: "chat" (chat/completions, default) or "responses" (Responses API, e.g. gpt-4.1/gpt-5).
# TDP_AZURE_API=chat

# --- Advanced / optional ----------------------------------------------------
# Endpoint override (rarely needed):
# TDP_LLM_ENDPOINT=
# Pre-obtained Copilot token (otherwise the cached device-flow token is used):
# TDP_COPILOT_TOKEN=

# --- Web --------------------------------------------------------------------
TDP_WEB_PORT=8080
